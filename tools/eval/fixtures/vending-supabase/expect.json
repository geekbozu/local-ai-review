  },
  {
    "id": "stale-timeout-comment",
    "path": ".github/workflows/ci.yml",
    "severity": "low",
    "any": [
      "twenty",
      "20 minutes",
      "timeout-minutes",
      "timeout is 90"
    ],
    "why": "the comment justifies twenty minutes; the value is 90"
  },
  {
    "id": "readme-drift",
    "path": "README.md",
    "severity": "low",
    "any": [
      "maybeSingle",
      "single()",
      "no longer",
      "contradicts"
    ],
    "why": "the change moved to one() and left the README telling callers to use maybeOne"
  }
